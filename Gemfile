source "https://rubygems.org"

# Local development uses Jekyll 4. GitHub Pages' classic build (deploy from
# branch) uses its own pinned Jekyll 3.9 and ignores this file — the site is
# written to be compatible with both, so a plain `git push` to main deploys it.
gem "jekyll", "~> 4.4"
gem "webrick", "~> 1.8"   # required to run `jekyll serve` on Ruby 3+
